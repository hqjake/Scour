<UserControl x:Class="Scour.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Scour.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,24">
            <TextBlock Style="{StaticResource Caption}" FontSize="13">
                <Run Text="{Binding Greeting, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding MachineName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="System status" Style="{StaticResource PageTitle}" FontSize="36" />
            <TextBlock Style="{StaticResource Caption}" FontSize="13">
                <Run Text="{Binding OsName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding CpuName, Mode=OneWay}" /><Run Text="  ·  up " /><Run Text="{Binding Uptime, Mode=OneWay}" />
            </TextBlock>

            <!-- Gauges -->
            <UniformGrid Columns="3" Margin="0,24,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20">
                    <Grid>
                        <c:RingGauge Value="{Binding CpuPercent}" Width="150" Height="150" Thickness="12" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0}%}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource DisplayFont}" />
                            <TextBlock Text="CPU" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="20">
                    <Grid>
                        <c:RingGauge Value="{Binding RamPercent}" Width="150" Height="150" Thickness="12" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding RamPercent, StringFormat={}{0:0}%}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource DisplayFont}" />
                            <TextBlock Text="MEMORY" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding RamText}" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="12,0,0,0" Padding="20">
                    <Grid>
                        <c:RingGauge Value="{Binding DiskPercent}" Width="150" Height="150" Thickness="12" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DiskPercent, StringFormat={}{0:0}%}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource DisplayFont}" />
                            <TextBlock Text="SYSTEM DRIVE" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding DiskText}" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Counters -->
            <UniformGrid Columns="2" Margin="0,12,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" FontSize="26" Foreground="{DynamicResource Scour.AccentHiBrush}" Effect="{StaticResource SoftGlow}" />
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="{Binding ProgramCount}" FontSize="26" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" />
                            <TextBlock Text="installed programs" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="26" Foreground="{DynamicResource Scour.Neon2Brush}" Effect="{StaticResource SoftGlow}" />
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="{Binding StartupCount}" FontSize="26" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" />
                            <TextBlock Text="programs start with Windows" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Quick actions -->
            <TextBlock Text="Quick actions" Style="{StaticResource SectionTitle}" Margin="0,26,0,10" />
            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Margin="0,0,12,12" Cursor="Hand" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Style="{StaticResource Card}" Padding="18,16">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Scour.AccentGradient}" Effect="{StaticResource NeonGlow}">
                                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="20" Foreground="White" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="200">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Drives -->
            <TextBlock Text="Drives" Style="{StaticResource SectionTitle}" Margin="0,14,0,10" />
            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" FontSize="22" Foreground="{DynamicResource Scour.AccentHiBrush}" />
                                <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                    <TextBlock>
                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  (" /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
