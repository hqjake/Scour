<UserControl x:Class="Scour.App.Views.TracesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Traced programs" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Programs installed through Scour. Their logs record every file and registry entry the installer created, for a perfect uninstall later."
                       Style="{StaticResource Caption}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding InstallAndTraceCommand}" Margin="0,0,8,0" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="14" />
                    <TextBlock Text="Install and trace…" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding UninstallCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" />
                    <TextBlock Text="Uninstall" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" Content="Delete log" />
            <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
            </Button>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Traces}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="{Binding CreatedUtc, Mode=OneWay, StringFormat=Traced {0:d}}" /><Run Text=" · " /><Run Text="{Binding Items.Count, Mode=OneWay}" /><Run Text=" items" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <Grid>
                    <TextBlock Text="{Binding DataContext.StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="360"
                               Visibility="{Binding Selected, Converter={StaticResource FalsyToVisibility}}" />
                    <Grid Visibility="{Binding Selected, Converter={StaticResource TruthyToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" FontSize="16" />
                            <Button Grid.Column="1" Content="Rename" Command="{Binding SaveNameCommand}" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Margin="0,8,0,8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                            <Run Text="Installer: " /><Run Text="{Binding Selected.InstallerPath, Mode=OneWay}" />
                        </TextBlock>
                        <ListView Grid.Row="2" ItemsSource="{Binding SelectedItems}" HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Primary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Secondary}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Secondary, Converter={StaticResource TruthyToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="2,10,0,0" />
    </Grid>
</UserControl>
