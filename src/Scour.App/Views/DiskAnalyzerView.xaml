<UserControl x:Class="Scour.App.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Scour.App.Controls"
             xmlns:vm="clr-namespace:Scour.App.ViewModels">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Disk space analyzer" Style="{StaticResource PageTitle}" />
            <TextBlock Text="See exactly what fills your drives. NTFS drives are read straight from the Master File Table, so even a full disk takes seconds."
                       Style="{StaticResource Caption}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,12">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Label" Width="380" Margin="0,0,8,0" />
                <Button Command="{Binding ScanCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14" />
                        <TextBlock Text="Scan drive" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Content="Scan a folder…" Command="{Binding ScanFolderCommand}" Style="{StaticResource ToolButton}" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ToolButton}"
                        Visibility="{Binding IsLoading, Converter={StaticResource TruthyToVisibility}}" />
            </StackPanel>
            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,10,0,0"
                         IsIndeterminate="{Binding Progress, Converter={StaticResource ZeroToTrue}}"
                         Visibility="{Binding IsLoading, Converter={StaticResource TruthyToVisibility}}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="250" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Folder tree -->
            <Border Style="{StaticResource Panel}" Padding="4">
                <TreeView x:Name="Tree" ItemsSource="{Binding Tree}" Background="Transparent" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectedItemChanged="Tree_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:DiskNodeViewModel}" ItemsSource="{Binding Children}">
                            <Grid Width="320">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="13" Margin="0,0,6,0"
                                           Foreground="{DynamicResource Scour.AccentHiBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Grid Grid.Column="2" Margin="6,0" VerticalAlignment="Center" Height="12">
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="12" Effect="{x:Null}" />
                                    <TextBlock Text="{Binding PercentText}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                </Grid>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="250" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Command="{Binding ZoomOutCommand}" ToolTip="Up one level">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ZoomCommand}" ToolTip="Zoom into selection">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A3;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ZoomResetCommand}" ToolTip="Whole drive">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="2" Effect="{StaticResource SoftGlow}">
                    <Grid>
                        <c:TreemapControl x:Name="Map" Root="{Binding Focus}" Selected="{Binding Selected}" Version="{Binding Version}" />
                        <TextBlock Text="Scan a drive to see its treemap.&#x0a;Click a tile to select it, double-click a folder to zoom in."
                                   Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Root, Converter={StaticResource FalsyToVisibility}}" />
                    </Grid>
                </Border>

                <TabControl Grid.Row="2" Margin="0,10,0,0" Background="Transparent">
                    <TabItem Header="File types">
                        <DataGrid ItemsSource="{Binding Extensions}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="None" RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Type" Binding="{Binding Extension}" Width="*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="100" />
                                <DataGridTemplateColumn Header="Share" Width="150" SortMemberPath="Percent">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,0,8,0" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Files" Binding="{Binding Count, StringFormat=N0}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Largest files">
                        <DataGrid x:Name="Largest" ItemsSource="{Binding LargestFiles}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="None" RowHeight="28" SelectionChanged="Largest_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                                <DataGridTextColumn Header="Folder" Binding="{Binding Parent.FullPath}" Width="*" />
                                <DataGridTextColumn Header="Size (bytes)" Binding="{Binding Size, StringFormat=N0}" Width="130" />
                                <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedUtc, StringFormat=d}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="2,10,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                <TextBlock Style="{StaticResource Caption}" Visibility="{Binding Selected, Converter={StaticResource TruthyToVisibility}}">
                    <Run Text="{Binding SelectedPath, Mode=OneWay}" Foreground="{DynamicResource Scour.TextBrush}" /><Run Text="  ·  " /><Run Text="{Binding SelectedSize, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Open in Explorer" Command="{Binding OpenCommand}" Style="{StaticResource ToolButton}" />
                <Button Content="Delete…" Command="{Binding DeleteCommand}" Style="{StaticResource ToolButton}" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
