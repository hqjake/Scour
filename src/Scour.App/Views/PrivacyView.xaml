<UserControl x:Class="Scour.App.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Privacy tweaks" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Switch off Windows telemetry, ads, suggestions and AI data collection. Scour saves the original settings before changing anything, so each switch can be turned back exactly." />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <Button Command="{Binding ApplyRecommendedCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="14" />
                    <TextBlock Text="Apply recommended" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button Content="Undo all" Command="{Binding UndoAllCommand}" Style="{StaticResource ToolButton}" />
            <Button Content="Restart Explorer" Command="{Binding RestartExplorerCommand}" Style="{StaticResource ToolButton}"
                    ToolTip="Some changes (Start search, taskbar buttons) show up after Explorer restarts" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding View}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="2,12,0,8" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                                        <Run x:Name="Rec" Text="  recommended" FontSize="11" Foreground="{DynamicResource Scour.AccentHiBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontStyle="Italic" Margin="0,2,0,0"
                                               Visibility="{Binding Note, Converter={StaticResource TruthyToVisibility}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <CheckBox IsChecked="{Binding IsOn}" MinWidth="0" VerticalAlignment="Center" ToolTip="On = private" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Recommended}" Value="False">
                                <Setter TargetName="Rec" Property="Text" Value="" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="2,10,0,0" />
    </Grid>
</UserControl>
