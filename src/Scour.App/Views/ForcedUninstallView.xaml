<UserControl x:Class="Scour.App.Views.ForcedUninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,12" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Forced uninstall" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,20"
                       Text="For programs that are partly uninstalled, missing from the list, or whose uninstaller is broken. Tell Scour what you know about the program and it will search for everything it left behind." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Program name" Style="{StaticResource Caption}" />
                    <ComboBox IsEditable="True" Text="{Binding ProgramName, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding KnownNames}"
                              IsTextSearchEnabled="True" Margin="0,4,0,4" />
                    <TextBlock Text="{Binding MatchedProgramText}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               Visibility="{Binding HasMatchedProgram, Converter={StaticResource TruthyToVisibility}}" />
                    <CheckBox Content="Run its uninstaller first" IsChecked="{Binding RunUninstallerFirst}" Margin="0,6,0,0"
                              Visibility="{Binding HasMatchedProgram, Converter={StaticResource TruthyToVisibility}}" />

                    <TextBlock Text="Publisher (optional)" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                    <TextBox Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />

                    <TextBlock Text="Install folder (optional)" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding InstallFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Folder…" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Content="From a program file…" Command="{Binding BrowseExecutableCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Picking one of the program's .exe files fills in the name, publisher and folder for you. Tip: Hunter mode in the sidebar can do this from a running window." />

                    <Button Content="Scan for leftovers" Command="{Binding ScanCommand}" Style="{DynamicResource AccentButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,20,0,0" MinWidth="150" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
