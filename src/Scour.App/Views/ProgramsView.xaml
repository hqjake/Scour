<UserControl x:Class="Scour.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Installed programs" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Uninstall programs completely: Scour runs each program's own uninstaller, then finds and removes what it left behind."
                       Style="{StaticResource Caption}" />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Command="{Binding UninstallCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Uninstall" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding QuickUninstallCommand}"
                        ToolTip="Runs the uninstaller (silently when possible) and removes Safe leftovers automatically. Select several programs to batch uninstall.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="14" />
                        <TextBlock Text="Quick uninstall" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ExportListCommand}" ToolTip="Export the list to a CSV file">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEDE1;" FontSize="14" />
                </Button>
                <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Filters}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Filter}" Width="250" Margin="0,0,8,0" />
                <Grid Width="260">
                    <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,6,8,6" VerticalContentAlignment="Center" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="13" Margin="11,0,0,0" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                    <TextBlock Text="Search name, publisher, version" Margin="33,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding Text, ElementName=Search, Converter={StaticResource FalsyToVisibility}}" />
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="Grid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" SelectionMode="Extended"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                      CanUserResizeRows="False" CanUserAddRows="False" RowHeight="40"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Uninstall…" Command="{Binding UninstallCommand}" />
                        <MenuItem Header="Quick uninstall" Command="{Binding QuickUninstallCommand}" />
                        <Separator />
                        <MenuItem Header="Open install folder" Command="{Binding OpenFolderCommand}" />
                        <MenuItem Header="Open registry key" Command="{Binding OpenRegistryCommand}" />
                        <MenuItem Header="Search online" Command="{Binding SearchOnlineCommand}" />
                        <MenuItem Header="Publisher website" Command="{Binding OpenHelpLinkCommand}" />
                        <Separator />
                        <MenuItem Header="Remove entry from list…" Command="{Binding RemoveEntryCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="24" Height="24" Margin="4,0,10,0">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource FalsyToVisibility}}" />
                                        <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="13" Margin="8,0,0,0"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               ToolTip="The uninstaller is missing. Uninstalling will clean up the leftovers instead."
                                               Visibility="{Binding IsBroken, Converter={StaticResource TruthyToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" />
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="170" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="80" />
                    <DataGridTextColumn Header="Installed" Binding="{Binding InstallDateText}" SortMemberPath="InstallDate" Width="95" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="55" />
                </DataGrid.Columns>
            </DataGrid>

            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="3"
                         Visibility="{Binding IsLoading, Converter={StaticResource TruthyToVisibility}}" />

            <!-- Details -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <Grid>
                    <TextBlock Text="Select a program to see its details." Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Selected, Converter={StaticResource FalsyToVisibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                                  Visibility="{Binding Converter={StaticResource TruthyToVisibility}}">
                        <StackPanel>
                            <Image Source="{Binding Icon}" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Publisher}" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,16" />

                            <TextBlock Text="Version" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Version}" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <TextBlock Text="Installed" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding InstallDateText}" Margin="0,0,0,10" />
                            <TextBlock Text="Size" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding SizeText}" Margin="0,0,0,10" />
                            <TextBlock Text="Type" Style="{StaticResource Caption}" />
                            <TextBlock Margin="0,0,0,10">
                                <Run Text="{Binding Type, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Architecture, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Scope, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Text="Install folder" Style="{StaticResource Caption}" />
                            <Button Content="{Binding InstallLocation}" Style="{StaticResource LinkButton}" Margin="0,0,0,10"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding InstallLocation, Converter={StaticResource TruthyToVisibility}}" />
                            <TextBlock Text="Not registered" Margin="0,0,0,10"
                                       Visibility="{Binding InstallLocation, Converter={StaticResource FalsyToVisibility}}" />

                            <TextBlock Text="Registry key" Style="{StaticResource Caption}" />
                            <Button Content="{Binding RegistryKey}" Style="{StaticResource LinkButton}" Margin="0,0,0,10"
                                    Command="{Binding DataContext.OpenRegistryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                            <TextBlock Text="Uninstall command" Style="{StaticResource Caption}" />
                            <TextBox Text="{Binding Program.UninstallString, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,10" />

                            <StackPanel Visibility="{Binding Program.ProductCode, Converter={StaticResource TruthyToVisibility}}">
                                <TextBlock Text="Windows Installer product code" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding Program.ProductCode, Mode=OneWay}" IsReadOnly="True" FontSize="12" Margin="0,2,0,10" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding HelpLink, Converter={StaticResource TruthyToVisibility}}">
                                <TextBlock Text="Website" Style="{StaticResource Caption}" />
                                <Button Content="{Binding HelpLink}" Style="{StaticResource LinkButton}" Margin="0,0,0,10"
                                        Command="{Binding DataContext.OpenHelpLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Program.Comments, Converter={StaticResource TruthyToVisibility}}">
                                <TextBlock Text="Comments" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Program.Comments}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="2,10,0,0" />
    </Grid>
</UserControl>
