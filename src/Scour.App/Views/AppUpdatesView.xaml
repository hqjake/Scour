<UserControl x:Class="Scour.App.Views.AppUpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="App updates" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Find outdated programs and update them all at once, silently, using Windows Package Manager (winget)." Style="{StaticResource Caption}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <Button Command="{Binding UpdateSelectedCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="14" />
                    <TextBlock Text="Update selected" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button Content="Select all" Command="{Binding SelectAllCommand}" Style="{StaticResource ToolButton}" />
            <Button Content="Select none" Command="{Binding SelectNoneCommand}" Style="{StaticResource ToolButton}" />
            <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Check again">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
            </Button>
            <Button Content="Stop" Command="{Binding CancelCommand}" Style="{StaticResource ToolButton}"
                    Visibility="{Binding IsUpdating, Converter={StaticResource TruthyToVisibility}}" />
            <CheckBox Content="Include apps with unknown versions" IsChecked="{Binding IncludeUnknown}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Updates}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                      CanUserAddRows="False" SelectionMode="Single" RowHeight="38">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0"
                                          IsEnabled="{Binding IsIgnored, Converter={StaticResource InverseBool}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Installed" Binding="{Binding Version}" Width="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Scour.AccentHiBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="220" IsReadOnly="True" />
                    <DataGridTemplateColumn Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Padding="8,2" Background="Transparent" BorderThickness="0" ToolTip="Ignore / un-ignore updates for this app"
                                        Command="{Binding DataContext.ToggleIgnoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <TextBlock Text="Ignore" Foreground="{DynamicResource Scour.Text2Brush}" FontSize="12" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Expander Grid.Row="1" Header="Installer output" Margin="0,10,0,0">
                <ListBox ItemsSource="{Binding Log}" Height="160" FontFamily="Consolas" FontSize="12" />
            </Expander>
        </Grid>

        <StackPanel Grid.Row="3" Margin="2,10,0,0">
            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,0,0,6"
                         IsIndeterminate="{Binding Progress, Converter={StaticResource ZeroToTrue}}"
                         Visibility="{Binding IsLoading, Converter={StaticResource TruthyToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
        </StackPanel>
    </Grid>
</UserControl>
