<UserControl x:Class="Scour.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Scour.App.Controls">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Network" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" Text="Pick a faster or more private DNS, test your connection speed, find saved Wi-Fi passwords and edit the hosts file." />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,14,0,0" Background="Transparent" BorderThickness="0">
            <!-- DNS -->
            <TabItem Header="DNS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding Adapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE839;" FontSize="20" Foreground="{DynamicResource Scour.AccentHiBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <TextBlock>
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding Kind, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Caption}">
                                                    <Run Text="{Binding Description, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Address, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PresetName}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource Scour.AccentHiBrush}" />
                                                <TextBlock Text="{Binding DnsText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,10,0,8">
                            <TextBlock Text="DNS services" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            <Button Content="Test again" Command="{Binding TestDnsCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,8,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock x:Name="Ms" Text="{Binding Latency}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource Scour.Text2Brush}" />
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,4,0,8">
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Servers}" Style="{StaticResource Caption}" Margin="0,4,0,0" FontFamily="Consolas" />
                                            </StackPanel>
                                            <Grid Grid.Row="2">
                                                <TextBlock x:Name="Tag" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <Button x:Name="Use" Content="Use this" HorizontalAlignment="Right" Style="{StaticResource ToolButton}"
                                                        Command="{Binding DataContext.UseDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFastest}" Value="True">
                                            <Setter TargetName="Ms" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <Setter TargetName="Tag" Property="Text" Value="Fastest from here" />
                                            <Setter TargetName="Tag" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Scour.AccentBrush}" />
                                            <Setter TargetName="Use" Property="Content" Value="In use" />
                                            <Setter TargetName="Use" Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding DnsStatus}" Style="{StaticResource Caption}" Margin="2,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Speed test -->
            <TabItem Header="Speed test">
                <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Grid Width="200" Height="200" Margin="20,0">
                            <c:RingGauge Value="{Binding DownloadGauge}" Thickness="14" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DownloadText}" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Mbps DOWN" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Width="200" Height="200" Margin="20,0">
                            <c:RingGauge Value="{Binding UploadGauge}" Thickness="14" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding UploadText}" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Mbps UP" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Card}" Width="200" Height="200" Margin="20,0" CornerRadius="100">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PingText}" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="ms PING" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button Command="{Binding RunSpeedTestCommand}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="28,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xEC4A;" FontSize="16" />
                            <TextBlock x:Name="GoText" Text="Start test" Margin="10,0,0,0" FontSize="15" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding SpeedPhase}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,18,0,0"
                               Visibility="{Binding PublicIp, Converter={StaticResource TruthyToVisibility}}">
                        <Run Text="Public IP " /><Run Text="{Binding PublicIp, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding Location, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </TabItem>

            <!-- Wi-Fi -->
            <TabItem Header="Wi-Fi passwords">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Command="{Binding LoadWifiCommand}" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE701;" FontSize="14" />
                            <TextBlock Text="Show saved networks" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Wifi}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                              CanUserAddRows="False" SelectionMode="Single" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Network" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Security" Binding="{Binding Security}" Width="180" IsReadOnly="True" />
                            <DataGridTextColumn Header="Password" Binding="{Binding PasswordText}" Width="*" IsReadOnly="True" FontFamily="Consolas" />
                            <DataGridTemplateColumn Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasPassword, Converter={StaticResource TruthyToVisibility}}">
                                            <ToggleButton Content="Reveal" IsChecked="{Binding IsRevealed}" Padding="10,2" Margin="0,0,6,0" />
                                            <Button Content="Copy" Padding="10,2"
                                                    Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding WifiStatus}" Style="{StaticResource Caption}" Margin="2,8,0,0" />
                </Grid>
            </TabItem>

            <!-- Hosts -->
            <TabItem Header="Hosts file">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}" Width="140" ToolTip="0.0.0.0 blocks the site" />
                        <Grid Width="280" Margin="8,0">
                            <TextBox x:Name="HostBox" Text="{Binding NewHost, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="example.com" Margin="11,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding Text, ElementName=HostBox, Converter={StaticResource FalsyToVisibility}}" />
                        </Grid>
                        <Button Content="Add line" Command="{Binding AddHostCommand}" Style="{StaticResource ToolButton}" />
                        <Button Command="{Binding SaveHostsCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0"
                                IsEnabled="{Binding HostsDirty}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" FontSize="14" />
                                <TextBlock Text="Save" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Content="Reload" Command="{Binding LoadHostsCommand}" Style="{StaticResource ToolButton}" Margin="8,0,0,0" />
                        <Button Content="Reset to default" Command="{Binding ResetHostsCommand}" Style="{StaticResource ToolButton}" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding HostsEntries}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                              CanUserAddRows="False" SelectionMode="Single" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="54" Header="On">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="150" IsReadOnly="True" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Host names" Binding="{Binding Hosts}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Effect" Binding="{Binding Meaning}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*" IsReadOnly="True" />
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Padding="8,2" Background="Transparent" BorderThickness="0" ToolTip="Delete this line"
                                                Command="{Binding DataContext.RemoveHostCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <TextBlock Text="Remove" Foreground="{DynamicResource Scour.Text2Brush}" FontSize="12" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding HostsStatus}" Style="{StaticResource Caption}" Margin="2,8,0,0" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="2,10,0,0">
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,6" Visibility="{Binding IsLoading, Converter={StaticResource TruthyToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
        </StackPanel>
    </Grid>
</UserControl>
