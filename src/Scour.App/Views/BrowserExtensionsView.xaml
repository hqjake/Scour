<UserControl x:Class="Scour.App.Views.BrowserExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Browser extensions" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Every extension in Chrome, Edge, Firefox, Brave, Opera and Vivaldi, with what it's allowed to do in plain words — and the ones programs forced in behind your back." />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,10">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
            <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Read again" HorizontalAlignment="Right">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Forced installs: the hijack kind. -->
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12" BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                        Visibility="{Binding Forced.Count, Converter={StaticResource TruthyToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="16" />
                            <TextBlock Text="Forced installs" FontWeight="SemiBold" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,8" TextWrapping="Wrap"
                                   Text="These registry entries install extensions you can't remove from the browser (it says &quot;Managed by your organization&quot;). Adware uses this trick; so do workplaces." />
                        <ItemsControl ItemsSource="{Binding Forced}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding Browser, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding ExtensionId, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Remove entry" Style="{StaticResource ToolButton}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveForcedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Extensions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12" Opacity="{Binding Opacity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Dot" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Top" Margin="0,5,14,0"
                                            Background="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            <Border x:Name="RiskBadge" Style="{StaticResource Badge}" Background="{DynamicResource Scour.CardBrush}" Margin="10,0,0,0">
                                                <TextBlock x:Name="RiskText" Text="{Binding Risk}" FontSize="10" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                    Visibility="{Binding Source, Converter={StaticResource TruthyToVisibility}}">
                                                <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Where}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Abilities}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Scour.AccentHiBrush}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Description, Converter={StaticResource TruthyToVisibility}}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Manage in browser" Style="{StaticResource ToolButton}" VerticalAlignment="Center" Margin="12,0,0,0"
                                            Command="{Binding DataContext.ManageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RiskKey}" Value="High">
                                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter TargetName="RiskText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RiskKey}" Value="Medium">
                                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Setter TargetName="RiskText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="2,10,0,0">
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,6" Visibility="{Binding IsLoading, Converter={StaticResource TruthyToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
