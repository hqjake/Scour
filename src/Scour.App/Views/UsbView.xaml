<UserControl x:Class="Scour.App.Views.UsbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="USB tools" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Format USB drives (including FAT32 on drives over 32 GB) or turn an ISO into a bootable USB stick. Only removable USB and SD drives are listed — your internal disks can't be picked here." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Drive" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" DisplayMemberPath="Display" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh" Margin="6,0,0,0">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
                                </Button>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <RadioButton Content="Format" GroupName="UsbTask" Margin="0,0,20,0"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Format}" />
                                <RadioButton Content="Make bootable" GroupName="UsbTask"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Bootable}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Bootable -->
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,12"
                            Visibility="{Binding Mode, Converter={StaticResource MatchToVisibility}, ConverterParameter=Bootable}">
                        <StackPanel>
                            <TextBlock Text="Boot image" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ImagePath}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="Choose…" Command="{Binding BrowseImageCommand}" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding ImageInfo}" Style="{StaticResource Caption}" Margin="0,6,0,10" />
                            <TextBlock Text="Write mode" Style="{StaticResource Caption}" />
                            <ComboBox ItemsSource="{Binding BootModes}" SelectedItem="{Binding SelectedBootMode}" DisplayMemberPath="Label" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Options" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Partition scheme" Style="{StaticResource Caption}" />
                            <ComboBox ItemsSource="{Binding Schemes}" SelectedItem="{Binding Scheme}" DisplayMemberPath="Label" Margin="0,4,0,10" />
                            <StackPanel Visibility="{Binding Mode, Converter={StaticResource MatchToVisibility}, ConverterParameter=Format}">
                                <TextBlock Text="File system" Style="{StaticResource Caption}" />
                                <ComboBox ItemsSource="{Binding FileSystems}" SelectedItem="{Binding FileSystem}" Margin="0,4,0,10" />
                                <TextBlock Text="Cluster size" Style="{StaticResource Caption}" />
                                <ComboBox ItemsSource="{Binding ClusterSizes}" SelectedItem="{Binding ClusterSize}" DisplayMemberPath="Label" Margin="0,4,0,10" />
                                <CheckBox Content="Quick format" IsChecked="{Binding QuickFormat}" Margin="0,0,0,10" />
                            </StackPanel>
                            <TextBlock Text="Volume label" Style="{StaticResource Caption}" />
                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="140" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="14" />
                                <TextBlock Text="Start" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ToolButton}"
                                Visibility="{Binding IsWorking, Converter={StaticResource TruthyToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="16,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Progress" Style="{StaticResource SectionTitle}" />
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8"
                                     IsIndeterminate="{Binding Progress, Converter={StaticResource ZeroToTrue}}"
                                     Visibility="{Binding IsWorking, Converter={StaticResource TruthyToVisibility}}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12" Background="Transparent" BorderThickness="0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
