<UserControl x:Class="Scour.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,20" />

            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox IsChecked="{Binding DarkTheme}">
                        <StackPanel>
                            <TextBlock Text="Dark mode" />
                            <TextBlock Style="{StaticResource Caption}" Text="Turn off for the light theme. You can also switch with the sun/moon button in the sidebar." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding SoundsEnabled}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Interface sounds" />
                            <TextBlock Style="{StaticResource Caption}" Text="Clicks, navigation, scan complete and cleanup finished." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <TextBlock Text="Automatic cleaning &amp; tray" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Clean junk automatically" />
                    <TextBlock Style="{StaticResource Caption}" Text="Runs quietly in the background with Windows Task Scheduler and only removes the safe, pre-ticked junk categories." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ComboBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding AutoClean}" Width="110" />
                        <ComboBox ItemsSource="{Binding Days}" SelectedItem="{Binding AutoCleanDay}" Width="130" Margin="8,0,0,0"
                                  Visibility="{Binding AutoClean, Converter={StaticResource MatchToVisibility}, ConverterParameter=Weekly}" />
                        <TextBlock Text="at" VerticalAlignment="Center" Margin="10,0,6,0"
                                   Visibility="{Binding AutoClean, Converter={StaticResource NotMatchToVisibility}, ConverterParameter=Off}" />
                        <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding AutoCleanHour}" ItemStringFormat="{}{0:00}:00" Width="90"
                                  Visibility="{Binding AutoClean, Converter={StaticResource NotMatchToVisibility}, ConverterParameter=Off}" />
                    </StackPanel>
                    <CheckBox Content="Also empty the Recycle Bin" IsChecked="{Binding AutoCleanRecycleBin}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding LastCleanupText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ScheduleStatus}" Style="{StaticResource Caption}" Foreground="{DynamicResource Scour.AccentHiBrush}" />

                    <CheckBox IsChecked="{Binding KeepInTray}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Keep Scour in the notification area when closed" />
                            <TextBlock Style="{StaticResource Caption}" Text="Right-click the tray icon for Quick clean, PC health and disk analysis." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Content="Start with Windows (in the notification area)" IsChecked="{Binding StartInTray}" Margin="0,12,0,0" />
                    <CheckBox Content="Warn me when the system drive is running out of space" IsChecked="{Binding LowDiskAlerts}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Uninstalling" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox IsChecked="{Binding CreateRestorePoint}">
                        <StackPanel>
                            <TextBlock Text="Create a system restore point before uninstalling" />
                            <TextBlock Style="{StaticResource Caption}" Text="Needs System Protection to be on for the system drive." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding QuickUninstallSilent}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Quick uninstall runs uninstallers silently when possible" />
                            <TextBlock Style="{StaticResource Caption}" Text="Supported for Windows Installer, Inno Setup and programs that register a quiet uninstall command." />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="Default leftover scan mode" Margin="0,16,0,4" />
                    <ComboBox ItemsSource="{Binding ScanModes}" SelectedItem="{Binding DefaultScanMode}" Width="200" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <TextBlock Text="Deleting" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox Content="Move deleted files and folders to the Recycle Bin" IsChecked="{Binding FilesToRecycleBin}" />
                    <CheckBox Content="Back up registry entries before deleting them" IsChecked="{Binding BackupRegistry}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Program list" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox Content="Show system components" IsChecked="{Binding ShowSystemComponents}" />
                    <CheckBox Content="Show Windows updates and hotfixes" IsChecked="{Binding ShowUpdates}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock>
                        <Run Text="Scour Uninstaller " FontWeight="SemiBold" /><Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0">
                        <Run Text="Backups and trace logs are stored in " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>
                    <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
