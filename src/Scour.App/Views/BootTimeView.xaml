<UserControl x:Class="Scour.App.Views.BootTimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Boot time" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="How long Windows takes to start, as Windows itself measures it, and what's slowing it down." />
            </StackPanel>
            <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,16,0,0">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Last start" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Latest}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LatestBreakdown}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Average (last 30)" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Average}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Trend}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Bars}" Height="180">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="34" Margin="2,0" ToolTip="{Binding ToolTip}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="4,4,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Scour.AccentLoBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Scour.AccentHiBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Slowing down your start" Style="{StaticResource SectionTitle}" />
                <Button Style="{StaticResource ToolButton}" Content="Open Startup programs" Command="{Binding OpenStartupProgramsCommand}" HorizontalAlignment="Right" />
            </Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding SlowStarters}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="None" RowHeight="30" Margin="0,8,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="120" />
                    <DataGridTextColumn Header="Adds" Binding="{Binding Delay}" Width="90" />
                    <DataGridTextColumn Header="Seen" Binding="{Binding Seen}" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,10,0,0" />
    </Grid>
</UserControl>
