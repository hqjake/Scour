<UserControl x:Class="Scour.App.Views.DeviceAccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Camera &amp; microphone" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="Which apps used your camera, microphone and location, and when. Block the ones that shouldn't." />
            </StackPanel>
            <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Capabilities}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="22" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Scour.AccentHiBrush}" />
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <CheckBox Content="Allow apps to use it" IsChecked="{Binding Allowed}" />
                                        <CheckBox Content="Allow desktop apps" IsChecked="{Binding DesktopAppsAllowed}" Margin="0,4,0,0"
                                                  ToolTip="Windows can only block desktop (non-Store) apps all together, not one by one" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Apps}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding LastUsed}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding InUse}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Scour.WarnBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <CheckBox Grid.Column="2" Content="Allowed" IsChecked="{Binding Allowed}" VerticalAlignment="Center"
                                                          Visibility="{Binding CanToggle, Converter={StaticResource TruthyToVisibility}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="2,10,0,0" />
    </Grid>
</UserControl>
