<UserControl x:Class="Scour.App.Views.BrowserPrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Browser privacy" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Clear browsing traces per browser and profile. Bookmarks, saved passwords, payment methods and settings are never touched. Caches are cleaned on the Junk cleaner page."
                       Style="{StaticResource Caption}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <Button Command="{Binding CleanCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" />
                    <TextBlock Text="Clear selected" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
            </Button>
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Profiles}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                  CanUserAddRows="False" SelectionMode="Single" RowHeight="40">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="170" IsReadOnly="True" />
                <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="150" IsReadOnly="True" />
                <DataGridTemplateColumn Header="History &amp; downloads" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding History, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Cookies" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Cookies, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Form entries" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding FormData, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Open tabs / sessions" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Sessions, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="2,10,0,0">
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6" Visibility="{Binding IsLoading, Converter={StaticResource TruthyToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
        </StackPanel>
    </Grid>
</UserControl>
