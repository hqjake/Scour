<UserControl x:Class="Scour.App.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Sensors" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Temperatures, fans and load, updated every two seconds." />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="360" Margin="0,0,12,12" Padding="16,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="18" Foreground="{DynamicResource Scour.AccentHiBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="290" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3">
                                                <Grid>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                                    <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="1">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Scour.WarnBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="2">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Scour.BadBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <ProgressBar Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}" Maximum="100" Height="4" Margin="0,4,0,0"
                                                             Visibility="{Binding Percent, Converter={StaticResource TruthyToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,10,0,0" />
    </Grid>
</UserControl>
