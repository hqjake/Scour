<UserControl x:Class="Scour.App.Views.ReinstallKitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Reinstall kit" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Save a list of your apps, then reinstall all of them in one go on a new or freshly reset PC — no hunting for installers."
                       Style="{StaticResource Caption}" />
        </StackPanel>

        <!-- The two halves of the workflow. -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,16,0,0">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" FontSize="26" Foreground="{DynamicResource Scour.AccentHiBrush}"
                               Effect="{StaticResource SoftGlow}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="1 · Make a kit on this PC" FontWeight="SemiBold" />
                        <TextBlock Text="Saves every app winget can reinstall to a small file. Keep it on a USB stick or in the cloud."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding SaveKitCommand}" Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save kit…" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="26" Foreground="{DynamicResource Scour.AccentHiBrush}"
                               Effect="{StaticResource SoftGlow}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="2 · Restore on the new PC" FontWeight="SemiBold" />
                        <TextBlock Text="Open the kit, untick anything you don't need and install the rest silently."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding OpenKitCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" FontSize="14" />
                            <TextBlock Text="Restore from kit…" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,18,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Showing}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding InstallSelectedCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"
                        Visibility="{Binding IsRestoreMode, Converter={StaticResource TruthyToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="14" />
                        <TextBlock Text="Install selected" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Content="Select all" Command="{Binding SelectAllCommand}" Style="{StaticResource ToolButton}" />
                <Button Content="Select none" Command="{Binding SelectNoneCommand}" Style="{StaticResource ToolButton}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding ScanThisPcCommand}" ToolTip="Show the apps on this PC">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
                </Button>
                <Button Content="Stop" Command="{Binding CancelCommand}" Style="{StaticResource ToolButton}"
                        Visibility="{Binding IsInstalling, Converter={StaticResource TruthyToVisibility}}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Apps}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                      CanUserAddRows="False" SelectionMode="Single" RowHeight="38">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0"
                                          IsEnabled="{Binding InstalledHere, Converter={StaticResource InverseBool}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Package ID" Binding="{Binding Id}" Width="260" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Scour.Text2Brush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="220" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
            <Expander Grid.Row="1" Header="Installer output" Margin="0,10,0,0"
                      Visibility="{Binding IsRestoreMode, Converter={StaticResource TruthyToVisibility}}">
                <ListBox ItemsSource="{Binding Log}" Height="160" FontFamily="Consolas" FontSize="12" />
            </Expander>
        </Grid>

        <StackPanel Grid.Row="4" Margin="2,10,0,0">
            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,0,0,6"
                         IsIndeterminate="{Binding Progress, Converter={StaticResource ZeroToTrue}}"
                         Visibility="{Binding IsLoading, Converter={StaticResource TruthyToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
        </StackPanel>
    </Grid>
</UserControl>
