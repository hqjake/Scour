<UserControl x:Class="Scour.App.Views.GameModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Game mode" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="One switch that hands the PC over to your game. Everything it changes is put back exactly when you turn it off, even after a restart." />
        </StackPanel>

        <!-- The big switch. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,12" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7FC;" FontSize="34" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                            <Setter Property="Foreground" Value="{DynamicResource Scour.Text3Brush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Scour.OkBrush}" />
                                    <Setter Property="Effect" Value="{StaticResource SoftGlow}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Game mode is off" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter Property="Text" Value="Game mode is on" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                        <Run Text="{Binding OnSinceText, Mode=OneWay}" />
                        <Run Text="  Press " /><Run Text="{Binding HotkeyText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" to switch it from inside a game." />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding ToggleCommand}" Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Center" Padding="18,8">
                    <TextBlock Text="{Binding ToggleText}" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Boosts" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
                <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,8" Text="Turn Game mode off to change which boosts it uses."
                           Visibility="{Binding IsOn, Converter={StaticResource TruthyToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Boosts}" IsEnabled="{Binding CanChooseBoosts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontStyle="Italic" Margin="0,2,0,0"
                                                   Visibility="{Binding Note, Converter={StaticResource TruthyToVisibility}}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked}" MinWidth="0" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Log}" Margin="2,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Caption}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="2,10,0,0" />
    </Grid>
</UserControl>
