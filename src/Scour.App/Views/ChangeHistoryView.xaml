<UserControl x:Class="Scour.App.Views.ChangeHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Change history" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Everything Scour has changed on this PC, newest first. Changes marked Undo can be reversed with one click." />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <Button Command="{Binding UndoCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" FontSize="14" />
                    <TextBlock Text="Undo" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ReloadCommand}" Style="{StaticResource ToolButton}" ToolTip="Refresh">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
            </Button>
        </StackPanel>
        <ListBox Grid.Row="2" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="2,12,0,6" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Visibility="{Binding Detail, Converter={StaticResource TruthyToVisibility}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource Scour.AccentLoBrush}" Visibility="{Binding CanUndo, Converter={StaticResource TruthyToVisibility}}">
                                <TextBlock Text="Can undo" FontSize="11" />
                            </Border>
                            <TextBlock Text="Undone" Style="{StaticResource Caption}" FontStyle="Italic"
                                       Visibility="{Binding Undone, Converter={StaticResource TruthyToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,10,0,0" />
    </Grid>
</UserControl>
