<UserControl x:Class="Scour.App.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Backups" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Every removal saves the deleted registry entries here. Deleted files go to the Recycle Bin (unless you turned that off in Settings)."
                       Style="{StaticResource Caption}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <Button Style="{StaticResource ToolButton}" Command="{Binding RestoreCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE777;" FontSize="14" />
                    <TextBlock Text="Restore registry" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding OpenRegFileCommand}" Content="Show .reg file" />
            <Button Style="{StaticResource ToolButton}" Command="{Binding OpenRecycleBinCommand}" Content="Open Recycle Bin" />
            <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" Content="Delete backup" />
            <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
            </Button>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding ProgramName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="{Binding CreatedUtc, Mode=OneWay, StringFormat={}{0:g} UTC}" /><Run Text=" · " /><Run Text="{Binding Items.Count, Mode=OneWay}" /><Run Text=" items" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <Grid>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" MaxWidth="360" Visibility="{Binding Selected, Converter={StaticResource FalsyToVisibility}}" />
                    <ListView ItemsSource="{Binding SelectedItems}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Selected, Converter={StaticResource TruthyToVisibility}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" ToolTip="{Binding Reasons}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Primary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Secondary}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Secondary, Converter={StaticResource TruthyToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
