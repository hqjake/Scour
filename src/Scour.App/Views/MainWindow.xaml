<Window x:Class="Scour.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Scour.App.ViewModels"
        xmlns:v="clr-namespace:Scour.App.Views"
        Title="Scour Uninstaller" Width="1240" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="/Assets/scour.ico">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ProgramsViewModel}"><v:ProgramsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindowsAppsViewModel}"><v:WindowsAppsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TracesViewModel}"><v:TracesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ForcedUninstallViewModel}"><v:ForcedUninstallView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutorunViewModel}"><v:AutorunView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:JunkViewModel}"><v:JunkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupsViewModel}"><v:BackupsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BrowserPrivacyViewModel}"><v:BrowserPrivacyView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileFinderViewModel}"><v:FileFinderView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistryCleanerViewModel}"><v:RegistryCleanerView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Grid Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="18,20,0,18">
                <Image Source="/Assets/scour.png" Width="28" Height="28" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Scour" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Uninstaller" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}"
                     ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Width="20" />
                            <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Margin="8,0,8,12">
                <!-- Hunter mode: press on the target and release it over any window. -->
                <Border x:Name="HunterTarget" Style="{StaticResource Card}" Padding="12" Margin="4,0,4,8" Cursor="Cross"
                        ToolTip="Press and drag this target onto any window, desktop icon or tray app, then release to see which program it belongs to."
                        PreviewMouseLeftButtonDown="Hunter_MouseDown" PreviewMouseLeftButtonUp="Hunter_MouseUp">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE707;" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Hunter mode" FontWeight="SemiBold" />
                            <TextBlock Text="Drag onto a window" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="4,0"
                        Click="Settings_Click" Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Width="20" />
                        <TextBlock Text="Settings" Margin="12,0,0,0" />
                    </StackPanel>
                </Button>

                <TextBlock Text="Not running as administrator — some programs and leftovers can't be removed."
                           Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="8,8,8,0"
                           Visibility="{Binding IsElevated, Converter={StaticResource FalsyToVisibility}}" />
            </StackPanel>
        </Grid>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />
    </Grid>
</Window>
