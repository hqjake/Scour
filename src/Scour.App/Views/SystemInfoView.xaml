<UserControl x:Class="Scour.App.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="System information" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Every part inside this PC: processor, memory modules, graphics, motherboard, drives and more." Style="{StaticResource Caption}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <Button Command="{Binding ExportCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" FontSize="14" />
                    <TextBlock Text="Save report" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button Content="Copy to clipboard" Command="{Binding CopyCommand}" Style="{StaticResource ToolButton}" />
            <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
            </Button>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Scour.SubtleBrush}" BorderBrush="{DynamicResource Scour.StrokeBrush}" BorderThickness="1">
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="17" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Scour.AccentHiBrush}" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="200">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Scour.TextBrush}" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="24" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Error, StringFormat='Not available: {0}'}" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding Error, Converter={StaticResource TruthyToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Scour.AccentHiBrush}" />
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="230" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="13" />
                                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                                 Background="Transparent" Padding="0" TextWrapping="Wrap" FontSize="13"
                                                                 Foreground="{DynamicResource Scour.TextBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="3" Margin="2,10,0,0">
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6" Visibility="{Binding IsLoading, Converter={StaticResource TruthyToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
        </StackPanel>
    </Grid>
</UserControl>
