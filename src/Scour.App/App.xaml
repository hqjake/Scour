<Application x:Class="Scour.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Scour.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Windows 11 "Fluent" look; follows the system light/dark setting. -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:MatchToVisibilityConverter x:Key="MatchToVisibility" />
            <local:MatchToVisibilityConverter x:Key="NotMatchToVisibility" Invert="True" />
            <local:TruthyToVisibilityConverter x:Key="TruthyToVisibility" />
            <local:TruthyToVisibilityConverter x:Key="FalsyToVisibility" Invert="True" />
            <local:EnumToBoolConverter x:Key="EnumToBool" />
            <local:StepOpacityConverter x:Key="StepOpacity" />
            <local:InverseBoolConverter x:Key="InverseBool" />

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <Style x:Key="Glyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="MinHeight" Value="32" />
            </Style>

            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" TextDecorations="Underline" Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Navigation rail item with the Windows 11 accent pill. -->
            <Style x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="4,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="12,9">
                                <Grid>
                                    <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                            Margin="-12,0,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                    <ContentPresenter />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small rounded label used for confidence levels and tags. -->
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <DataTemplate x:Key="ConfidenceBadge">
                <Border x:Name="B" Style="{StaticResource Badge}" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                    <TextBlock x:Name="T" Text="{Binding ConfidenceText}" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding ConfidenceText}" Value="Moderate">
                        <Setter TargetName="B" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ConfidenceText}" Value="Risky">
                        <Setter TargetName="B" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- One row of a leftover list (wizard, trace review, backups). -->
            <DataTemplate x:Key="LeftoverRow">
                <Grid Margin="0,3" ToolTip="{Binding Reasons}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Glyph}" Text="{Binding Glyph}" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Primary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Secondary}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Secondary, Converter={StaticResource TruthyToVisibility}}" />
                        <TextBlock Text="{Binding Item.Reasons[0]}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <ContentControl Grid.Column="4" Content="{Binding}" ContentTemplate="{StaticResource ConfidenceBadge}" Focusable="False" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="GroupHeader">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,12,0,4" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
