<Application x:Class="Scour.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Scour.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] Fluent control templates, [1] Scour's violet cyber palette. ThemeService swaps both for light/dark. -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Scour;component/Themes/Cyber.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:MatchToVisibilityConverter x:Key="MatchToVisibility" />
            <local:MatchToVisibilityConverter x:Key="NotMatchToVisibility" Invert="True" />
            <local:TruthyToVisibilityConverter x:Key="TruthyToVisibility" />
            <local:TruthyToVisibilityConverter x:Key="FalsyToVisibility" Invert="True" />
            <local:EnumToBoolConverter x:Key="EnumToBool" />
            <local:StepOpacityConverter x:Key="StepOpacity" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:TranslateConverter x:Key="Tr" />
            <local:ZeroToTrueConverter x:Key="ZeroToTrue" />

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

            <DropShadowEffect x:Key="NeonGlow" BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="#8B5CF6" />
            <DropShadowEffect x:Key="NeonGlowStrong" BlurRadius="30" ShadowDepth="0" Opacity="0.85" Color="#A78BFA" />
            <DropShadowEffect x:Key="SoftGlow" BlurRadius="16" ShadowDepth="0" Opacity="0.35" Color="#8B5CF6" />

            <Style x:Key="Glyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource Scour.TitleBrush}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Scour.TextBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Glass card with a neon edge that lights up on hover. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Scour.CardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Scour.StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Scour.EdgeBrush}" />
                        <Setter Property="Background" Value="{DynamicResource Scour.CardHoverBrush}" />
                        <Setter Property="Effect" Value="{StaticResource SoftGlow}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Static panel (no hover) for large containers. -->
            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Scour.CardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Scour.StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Primary action: violet→magenta gradient with a neon glow; grows on hover, presses in on click. -->
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Glow" CornerRadius="8" Background="{DynamicResource Scour.AccentGradient}" Effect="{StaticResource NeonGlow}" Opacity="0.9" />
                                <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource Scour.AccentGradient}" BorderThickness="1"
                                        BorderBrush="#40FFFFFF" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="Shine" CornerRadius="8" IsHitTestVisible="False" Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#40FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.6" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Glow" Property="Effect" Value="{StaticResource NeonGlowStrong}" />
                                    <Setter TargetName="Shine" Property="Opacity" Value="1" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter TargetName="Glow" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="MinHeight" Value="34" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Effect" Value="{StaticResource SoftGlow}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" TextDecorations="Underline" Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Icon-only round button used in the sidebar footer. -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Scour.TextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="19" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Scour.SubtleBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Scour.AccentBrush}" />
                                    <Setter TargetName="Bd" Property="Effect" Value="{StaticResource SoftGlow}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Navigation rail item: neon pill + glow when selected, nudges right on hover. -->
            <Style x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="6,1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{DynamicResource Scour.Text2Brush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="12,8" BorderThickness="1" BorderBrush="Transparent">
                                <Grid>
                                    <Border x:Name="Pill" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0"
                                            Background="{DynamicResource Scour.AccentGradient}" Effect="{StaticResource NeonGlowStrong}" Visibility="Collapsed" />
                                    <ContentPresenter x:Name="Content">
                                        <ContentPresenter.RenderTransform><TranslateTransform /></ContentPresenter.RenderTransform>
                                    </ContentPresenter>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Scour.SubtleBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Scour.TextBrush}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="RenderTransform.X" To="3" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Scour.SubtleBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Scour.StrokeBrush}" />
                                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource Scour.AccentHiBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small rounded label used for confidence levels and tags. -->
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <DataTemplate x:Key="ConfidenceBadge">
                <Border x:Name="B" Style="{StaticResource Badge}" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                    <TextBlock x:Name="T" Text="{Binding ConfidenceText}" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding ConfidenceText}" Value="Moderate">
                        <Setter TargetName="B" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ConfidenceText}" Value="Risky">
                        <Setter TargetName="B" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- One row of a leftover list (wizard, trace review, backups). -->
            <DataTemplate x:Key="LeftoverRow">
                <Grid Margin="0,3" ToolTip="{Binding Reasons}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Glyph}" Text="{Binding Glyph}" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Primary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Secondary}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Secondary, Converter={StaticResource TruthyToVisibility}}" />
                        <TextBlock Text="{Binding Item.Reasons[0]}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <ContentControl Grid.Column="4" Content="{Binding}" ContentTemplate="{StaticResource ConfidenceBadge}" Focusable="False" />
                </Grid>
            </DataTemplate>

            <!-- Grid cells: vertically centred content; selection colour comes from the theme. -->
            <ControlTemplate x:Key="Scour.DataGridCellTemplate" TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                    <ContentPresenter VerticalAlignment="Center" Margin="6,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </Border>
            </ControlTemplate>

            <DataTemplate x:Key="GroupHeader">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,12,0,4" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
