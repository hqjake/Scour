<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Scour cyber palette (dark). Keys named Scour.* are ours; the rest override the Fluent theme. -->
    <SolidColorBrush x:Key="Scour.BgBrush" Color="#FF07060E" />
    <SolidColorBrush x:Key="Scour.Bg2Brush" Color="#FF0E0B1C" />
    <SolidColorBrush x:Key="Scour.SurfaceBrush" Color="#FF13112A" />
    <SolidColorBrush x:Key="Scour.CardBrush" Color="#CC161430" />
    <SolidColorBrush x:Key="Scour.CardHoverBrush" Color="#E01C1940" />
    <SolidColorBrush x:Key="Scour.StrokeBrush" Color="#FF2C2752" />
    <SolidColorBrush x:Key="Scour.StrokeHiBrush" Color="#FF8B5CF6" />
    <SolidColorBrush x:Key="Scour.TextBrush" Color="#FFF3F0FF" />
    <SolidColorBrush x:Key="Scour.Text2Brush" Color="#FFA9A3CC" />
    <SolidColorBrush x:Key="Scour.Text3Brush" Color="#FF6E6890" />
    <SolidColorBrush x:Key="Scour.AccentBrush" Color="#FF8B5CF6" />
    <SolidColorBrush x:Key="Scour.AccentHiBrush" Color="#FFA78BFA" />
    <SolidColorBrush x:Key="Scour.AccentLoBrush" Color="#FF6D28D9" />
    <SolidColorBrush x:Key="Scour.Neon2Brush" Color="#FF22D3EE" />
    <SolidColorBrush x:Key="Scour.Neon3Brush" Color="#FFE879F9" />
    <SolidColorBrush x:Key="Scour.SubtleBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Scour.GridBrush" Color="#0FA78BFA" />
    <SolidColorBrush x:Key="Scour.NavBrush" Color="#B00A0918" />
    <SolidColorBrush x:Key="Scour.OkBrush" Color="#FF34D399" />
    <SolidColorBrush x:Key="Scour.WarnBrush" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="Scour.BadBrush" Color="#FFF87171" />
    <Color x:Key="Scour.AccentColor">#FF8B5CF6</Color>
    <Color x:Key="Scour.AccentHiColor">#FFA78BFA</Color>
    <Color x:Key="Scour.Neon2Color">#FF22D3EE</Color>
    <Color x:Key="Scour.Neon3Color">#FFE879F9</Color>
    <Color x:Key="Scour.GlowColor">#FF8B5CF6</Color>
    <Color x:Key="Scour.Blob1Color">#558B5CF6</Color>
    <Color x:Key="Scour.Blob2Color">#3322D3EE</Color>
    <Color x:Key="Scour.Blob3Color">#40E879F9</Color>
    <Color x:Key="Scour.BgColor">#FF07060E</Color>
    <Color x:Key="Scour.Bg2Color">#FF0E0B1C</Color>
    <LinearGradientBrush x:Key="Scour.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6D28D9" Offset="0" /><GradientStop Color="#FF8B5CF6" Offset="0.5" /><GradientStop Color="#FFE879F9" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Scour.TitleBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFA78BFA" Offset="0" /><GradientStop Color="#FFE879F9" Offset="0.55" /><GradientStop Color="#FF22D3EE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Scour.EdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8B5CF6" Offset="0" /><GradientStop Color="#FF2C2752" Offset="0.45" /><GradientStop Color="#FF22D3EE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Scour.BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF07060E" Offset="0" /><GradientStop Color="#FF0E0B1C" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Scour.SelectionBrush" Color="#558B5CF6" />

    <!-- Fluent overrides -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF07060E" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF07060E" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#B00A0918" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF3F0FF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFA9A3CC" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF6E6890" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#CC161430" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF2C2752" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF8B5CF6" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFA78BFA" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF6D28D9" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFA78BFA" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFA78BFA" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF34D399" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#2234D399" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#22FBBF24" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFF87171" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#22F87171" />
    <Color x:Key="SystemAccentColor">#FF8B5CF6</Color>
    <Color x:Key="SystemAccentColorLight1">#FFA78BFA</Color>
    <Color x:Key="SystemAccentColorLight2">#FFA78BFA</Color>
    <Color x:Key="SystemAccentColorLight3">#FFA78BFA</Color>
    <Color x:Key="SystemAccentColorDark1">#FF6D28D9</Color>
    <Color x:Key="SystemAccentColorDark2">#FF6D28D9</Color>
    <Color x:Key="SystemAccentColorDark3">#FF6D28D9</Color>
</ResourceDictionary>
