<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Scour cyber palette (light). Keys named Scour.* are ours; the rest override the Fluent theme. -->
    <SolidColorBrush x:Key="Scour.BgBrush" Color="#FFF5F3FF" />
    <SolidColorBrush x:Key="Scour.Bg2Brush" Color="#FFEDE9FE" />
    <SolidColorBrush x:Key="Scour.SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Scour.CardBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="Scour.CardHoverBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="Scour.StrokeBrush" Color="#FFDDD6FE" />
    <SolidColorBrush x:Key="Scour.StrokeHiBrush" Color="#FF7C3AED" />
    <SolidColorBrush x:Key="Scour.TextBrush" Color="#FF1A1433" />
    <SolidColorBrush x:Key="Scour.Text2Brush" Color="#FF57507A" />
    <SolidColorBrush x:Key="Scour.Text3Brush" Color="#FF8F89AD" />
    <SolidColorBrush x:Key="Scour.AccentBrush" Color="#FF7C3AED" />
    <SolidColorBrush x:Key="Scour.AccentHiBrush" Color="#FF8B5CF6" />
    <SolidColorBrush x:Key="Scour.AccentLoBrush" Color="#FF5B21B6" />
    <SolidColorBrush x:Key="Scour.Neon2Brush" Color="#FF0891B2" />
    <SolidColorBrush x:Key="Scour.Neon3Brush" Color="#FFC026D3" />
    <SolidColorBrush x:Key="Scour.SubtleBrush" Color="#147C3AED" />
    <SolidColorBrush x:Key="Scour.GridBrush" Color="#127C3AED" />
    <SolidColorBrush x:Key="Scour.NavBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="Scour.OkBrush" Color="#FF059669" />
    <SolidColorBrush x:Key="Scour.WarnBrush" Color="#FFB45309" />
    <SolidColorBrush x:Key="Scour.BadBrush" Color="#FFDC2626" />
    <Color x:Key="Scour.AccentColor">#FF7C3AED</Color>
    <Color x:Key="Scour.AccentHiColor">#FF8B5CF6</Color>
    <Color x:Key="Scour.Neon2Color">#FF0891B2</Color>
    <Color x:Key="Scour.Neon3Color">#FFC026D3</Color>
    <Color x:Key="Scour.GlowColor">#FF7C3AED</Color>
    <Color x:Key="Scour.Blob1Color">#407C3AED</Color>
    <Color x:Key="Scour.Blob2Color">#3006B6D4</Color>
    <Color x:Key="Scour.Blob3Color">#30D946EF</Color>
    <Color x:Key="Scour.BgColor">#FFF5F3FF</Color>
    <Color x:Key="Scour.Bg2Color">#FFEDE9FE</Color>
    <LinearGradientBrush x:Key="Scour.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5B21B6" Offset="0" /><GradientStop Color="#FF7C3AED" Offset="0.5" /><GradientStop Color="#FFC026D3" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Scour.TitleBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF8B5CF6" Offset="0" /><GradientStop Color="#FFC026D3" Offset="0.55" /><GradientStop Color="#FF0891B2" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Scour.EdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7C3AED" Offset="0" /><GradientStop Color="#FFDDD6FE" Offset="0.45" /><GradientStop Color="#FF0891B2" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Scour.BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF5F3FF" Offset="0" /><GradientStop Color="#FFEDE9FE" Offset="1" />
    </LinearGradientBrush>

    <!-- Fluent overrides -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FFF5F3FF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFF5F3FF" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF1A1433" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF57507A" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF8F89AD" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FFDDD6FE" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF7C3AED" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF8B5CF6" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF5B21B6" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF7C3AED" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF8B5CF6" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#147C3AED" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0C7C3AED" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF059669" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#22059669" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFB45309" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#22B45309" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFDC2626" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#22DC2626" />
    <Color x:Key="SystemAccentColor">#FF7C3AED</Color>
    <Color x:Key="SystemAccentColorLight1">#FF8B5CF6</Color>
    <Color x:Key="SystemAccentColorLight2">#FF8B5CF6</Color>
    <Color x:Key="SystemAccentColorLight3">#FF8B5CF6</Color>
    <Color x:Key="SystemAccentColorDark1">#FF5B21B6</Color>
    <Color x:Key="SystemAccentColorDark2">#FF5B21B6</Color>
    <Color x:Key="SystemAccentColorDark3">#FF5B21B6</Color>
</ResourceDictionary>
